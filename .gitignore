# Segredos: NUNCA versionar. Hoje não há nenhum no repo (conferido na auditoria
# de 01/08/2026), e esta regra existe para que continue assim — um `.env` local
# criado por engano não vira commit.
.env
.env.*
!.env.example
*.pem
*.key

# Artefatos locais de revisão (gerados por agentes; aplicados ao Supabase, não versionados)
.review/

# Artefatos transitórios de expansão de resumos (multi-agente; regeneráveis pelos
# build*.js e aplicados ao Supabase — o registro durável é o banco + cofre/Decisões.md).
scratchpad/**/*.sql
scratchpad/**/*.b64
scratchpad/**/*.b64.part.*
scratchpad/**/chunk.*
scratchpad/basica/apply/
scratchpad/basica/expanded/
# WYSIWYG: harness de teste transitório (regenerável por gen_test.js)
scratchpad/wysiwyg/*.html
scratchpad/wysiwyg/*dom*.html
scratchpad/wysiwyg/index_converter.js
scratchpad/wysiwyg/theme.css
# Esporte/Endocrinopatias: SQL/base64/chunks transitórios (regeneráveis por build_insert.js)
scratchpad/esporte_endopat/*.sql
scratchpad/esporte_endopat/*.b64
scratchpad/esporte_endopat/chunk.*
scratchpad/esporte_endopat/part.*
# Revisão de flashcards: staging base64/chunks e saídas de workflow transitórias
# (regeneráveis por build_apply.js; o registro durável é o banco + cofre/Decisões.md).
scratchpad/flashcards/stage/
scratchpad/flashcards/items/
scratchpad/flashcards/*.output
scratchpad/flashcards/missing*.json

# ⚠️ Texto INTEGRAL de artigos científicos, baixado do Drive para a extração.
# NUNCA versionar: este repositório é PÚBLICO e o conteúdo é protegido por
# direito autoral (Nature Reviews, Osteoporosis International, Lancet…).
# O que pode ser versionado é o EXTRATO — fatos em português com citações curtas
# (trechos de uma frase), que é uso legítimo e é o que a base clínica precisa.
scratchpad/acervo/textos/
scratchpad/acervo/__pycache__/

# Rascunhos que os agentes criam durante a extração (fatiadores, checadores
# temporários, cache do Python). O que importa é o EXTRATO verificado.
scratchpad/acervo/__pycache__/
scratchpad/**/__pycache__/
scratchpad/*.py
scratchpad/acervo/*.py
scratchpad/work/
# (scratchpad/boot-navegador/ CONTINUA versionado: é o harness de navegador real,
#  ferramenta permanente, não rascunho de agente.)
